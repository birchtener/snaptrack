generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  // moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  owner
  admin
  scanner
}

enum LogType {
  in
  out
}

enum SystemAction {
  create_student
  update_student
  delete_student
  create_event
  update_event
  delete_event
  add_member
  update_member
  remove_member
  create_workspace
  update_workspace
  delete_workspace
}

model Workspace {
  id                      String   @id @default(uuid())
  name                    String
  created_by              String
  student_metadata_schema Json     @default("[]")
  created_at              DateTime @default(now())
  updated_at              DateTime @updatedAt

  // Relations
  memberships Membership[]
  students    Student[]
  events      Event[]
  event_logs  EventLog[]
  system_logs SystemLog[]
  creator     User         @relation("WorkspaceCreator", fields: [created_by], references: [id], onDelete: Restrict)

  @@map("workspaces")
}

model User {
  id         String    @id // @default(uuid())
  email      String    @unique
  first_name String
  last_name  String
  image_url  String?
  created_at DateTime  @default(now())
  deleted_at DateTime?

  // Relations
  memberships        Membership[]
  scanned_logs       EventLog[]
  system_logs        SystemLog[]
  events             Event[]
  added_students     Student[]
  created_workspaces Workspace[]  @relation("WorkspaceCreator")

  @@map("users")
}

model Membership {
  id           String   @id @default(uuid())
  role         Role     @default(scanner)
  user_id      String
  workspace_id String
  created_at   DateTime @default(now())

  // Relations
  user      User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspace_id], references: [id], onDelete: Cascade)

  @@unique([user_id, workspace_id])
  @@map("memberships")
}

model Student {
  id           String   @id @default(uuid())
  workspace_id String
  first_name   String
  last_name    String
  id_card_code String
  added_by     String
  metadata     Json     @default("{}")
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  // Relations
  workspace Workspace  @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  logs      EventLog[]
  adder     User       @relation(fields: [added_by], references: [id], onDelete: Restrict)

  @@unique([workspace_id, id_card_code])
  @@index([id_card_code])
  @@map("students")
}

model Event {
  id                String    @id @default(uuid())
  workspace_id      String
  name              String
  description       String?
  start_date        DateTime
  end_date          DateTime?
  infinite          Boolean   @default(false)
  geofencing_enabled Boolean   @default(false)
  latitude          Float?
  longitude         Float?
  radius            Float?
  is_active         Boolean   @default(true)
  created_at        DateTime  @default(now())
  created_by        String
  archived_at       DateTime?

  // Relations
  workspace Workspace  @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  logs      EventLog[]
  creator   User       @relation(fields: [created_by], references: [id], onDelete: Restrict)

  @@map("events")
}

model EventLog {
  id           String   @id @default(uuid())
  workspace_id String
  event_id     String
  student_id   String
  scanned_by   String
  type         LogType
  timestamp    DateTime @default(now())

  // Relations
  workspace Workspace @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  event     Event     @relation(fields: [event_id], references: [id], onDelete: Cascade)
  student   Student   @relation(fields: [student_id], references: [id], onDelete: Cascade)
  scanner   User      @relation(fields: [scanned_by], references: [id], onDelete: Restrict)

  @@index([event_id, timestamp(sort: Desc)])
  @@map("event_logs")
}

model SystemLog {
  id           String       @id @default(uuid())
  workspace_id String
  created_by   String
  action       SystemAction
  details      Json         @default("{}")
  timestamp    DateTime     @default(now())

  // Relations
  workspace Workspace @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  executor  User      @relation(fields: [created_by], references: [id], onDelete: Restrict)

  @@index([workspace_id, timestamp(sort: Desc)])
  @@map("system_logs")
}
