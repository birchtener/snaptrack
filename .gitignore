# ====================================================================
# Global / Monorepo Tooling (Applies everywhere)
# ====================================================================
.env
.DS_Store
Thumbs.db
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.pem

# Global Logs & Debugging
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
pids
*.pid
*.seed
*.pid.lock

# Global Dependencies (Root and Package level)
node_modules/
jspm_packages/
web_modules/

# Yarn Plug'n'Play & Berry specifics (if used)
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Monorepo Build Caches
.turbo/
.nx/

# ====================================================================
# App: snaptrack/backend (Express, Node, Prisma, Postgres)
# ====================================================================
# Build output
snaptrack/backend/dist/
snaptrack/backend/build/

# Local env files (Contains DB connection strings - NEVER COMMIT)
snaptrack/backend/.env
snaptrack/backend/.env.local
snaptrack/backend/.env.*.local

# Prisma specific
snaptrack/backend/prisma/*.db
snaptrack/backend/prisma/*.db-journal

# Local PostgreSQL data directory
snaptrack/backend/pgdata/
snaptrack/backend/postgres-data/

# Testing
snaptrack/backend/coverage/
snaptrack/backend/.nyc_output/

# Prisma
snaptrack/backend/src/generated/prisma

# ====================================================================
# App: snaptrack/frontend (Next.js, Tailwind, Vercel)
# ====================================================================
# Next.js build and cache outputs
snaptrack/frontend/.next/
snaptrack/frontend/out/
snaptrack/frontend/build/
snaptrack/frontend/dist/

# Vercel deployment tracking
snaptrack/frontend/.vercel

# TypeScript build info
snaptrack/frontend/*.tsbuildinfo

# Tailwind / Tooling cache
snaptrack/frontend/.tailwind/
snaptrack/frontend/.eslintcache

# Frontend Local env files
snaptrack/frontend/.env*

# Testing
snaptrack/frontend/coverage/