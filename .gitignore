# ====================================================================
# Global / Monorepo Tooling (Applies everywhere)
# ====================================================================
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.pem

# Global Logs & Debugging
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*
lerna-debug.log*
pids
*.pid
*.seed
*.pid.lock

# Global Dependencies & Package Managers
node_modules/
jspm_packages/
web_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Global Environment Files (Catch-all safety net)
.env
*.local

# Monorepo Build Caches
.turbo/
.nx/

# ====================================================================
# App: snaptrack/backend (Express, Node, Prisma, Postgres)
# ====================================================================
# Build outputs
snaptrack/backend/dist/
snaptrack/backend/build/

# Local env files (Contains sensitive DB URIs - NEVER COMMIT)
snaptrack/backend/.env
snaptrack/backend/.env.local
snaptrack/backend/.env.*.local

# Prisma engine & custom client targets
snaptrack/backend/prisma/*.db
snaptrack/backend/prisma/*.db-journal
snaptrack/backend/src/generated/prisma/

# Local PostgreSQL data engine persistence
snaptrack/backend/pgdata/
snaptrack/backend/postgres-data/

# Testing & code coverage outputs
snaptrack/backend/coverage/
snaptrack/backend/.nyc_output/

# ====================================================================
# App: snaptrack/frontend (Vite, React, Tailwind)
# ====================================================================
# Build and SSR compile outputs
snaptrack/frontend/dist/
snaptrack/frontend/dist-ssr/
snaptrack/frontend/build/

# Testing & tool caches
snaptrack/frontend/coverage/
snaptrack/frontend/.eslintcache
snaptrack/frontend/.tailwind/